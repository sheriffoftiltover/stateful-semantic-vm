 "B_deterministic_command_language": {
  "version": "SEMVM_CMD_V1",
  "parser": "deterministic (code/runtime commands.py); never neural",
  "grammar": [
   "QUERY <REL> OF <TARGET> [WHERE <SCOPE>.<REL>=<VALUE>]*        REL in WHO|WHEN|WHERE|RECIPIENT|TOPIC; SCOPE in SELF|PARENT|CHILD",
   "UPDATE <REF> <REL>=<VALUE> [<REL>=<VALUE>]*                    functional replace (retract active REL, assert new), one transaction",
   "RETRACT <REF> <REL>",
   "DELETE <REF>",
   "NEW PERSON <NAME>                                             explicitly create a distinct person with that alias (for ambiguity scenarios)"
  ],
  "TARGET": "an event type (REMINDER|PLAN|REQUEST|NOTE|CALL|EMAIL|VISIT|MESSAGE) = all active events of that type, or a REF",
  "REF": "LAST_<EVENT_TYPE> = the most recently created active event of that type (deterministic; none -> RESOLVE_REFERENCE failure)",
  "VALUE": "a PERSON / TIME / PLACE / TOPIC value token of the assertion vocabulary"
 },
 "unsupported_neural_inputs": [
  "ordinary unrestricted English",
  "> 2 modifiers",
  "> 2 event nodes (anything but 1 outer + 1 inner)",
  "unknown vocabulary",
  "unsupported relation types",
  "unsupported relation x constructor combinations (outside the supported triples)",
  "layouts outside the P0/P2 trained envelope (incl. BEFORE_BOTH geometry, held-out phrase format fc)",
  "arbitrary discourse / pronoun syntax"
 ],
 "unsupported_result": "UNSUPPORTED_INPUT (structured failure, no state mutation, no transformation into a supported input)",
 "time_semantics": "TIME values are clock/named values of the binder vocabulary; normalized deterministically (digits -> HH:MM, named -> NOON/MIDNIGHT/DAWN/DUSK); reference timestamp recorded per scenario, no relative dates exist in V1"
}